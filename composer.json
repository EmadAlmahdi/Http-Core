{
    "name": "temant/http-core",
    "description": "PSR-7 & PSR-17 Implementation",
    "type": "library",
    "require": {
        "php": "^8.6",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.1",
        "http-interop/http-factory-tests": "^2.0",
        "guzzlehttp/psr7": "^2.12",
        "nyholm/psr7": "^1.8",
        "laminas/laminas-diactoros": "^3.8",
        "slim/psr7": "^1.8"
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan",
        "test": "./vendor/bin/phpunit",
        "bench": "php benchmarks/run.php"
    },
    "autoload": {
        "psr-4": {
            "Temant\\HttpCore\\": "Src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Temant\\HttpCore\\Tests\\": "Tests/",
            "Temant\\HttpCore\\Benchmarks\\": "benchmarks/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT"
}
